# Copy values into your hosting environment; do not commit a populated .env.
# Use a dedicated FOUNDATION DB, never the preserved legacy/Core DB.
PORT=8080
EF_DB_URL=jdbc:postgresql://YOUR_PRIVATE_DB_HOST:5432/YOUR_FOUNDATION_DB
EF_DB_USERNAME=
EF_DB_PASSWORD=
EF_IDEMPOTENCY_FINGERPRINT_KEY=
EF_IDEMPOTENCY_ENCRYPTION_KEY=
EF_JWT_SIGNING_KEY=

# Bundled API + private Node/Python worker. No fixture accounts or automatic generation.
EF_AGENT_ENABLED=true
EF_AGENT_V2=true
EF_AGENT_BUNDLE_WORKER=true
EF_AGENT_PORT=5198
EF_AGENT_SERVICE_TOKEN=
# EF_AGENT_URL and EF_AGENT_STORAGE_ORIGIN default to this container's loopback ports.
EF_AGENT_MODEL=gpt-5.4
EF_AGENT_CONFIGURATION_REF=prototype-st-v2.1-ko4
EF_PROTOTYPE_PUBLICATION_ENABLED=true
EF_CORE_LEASE_SECONDS=30
EF_PROTOTYPE_TEST_CLOCK_ENABLED=false

# Safe default: MOCK makes no paid generation/synthesis requests.
EF_AGENT_MODE=MOCK
EF_PROTOTYPE_LIVE_ENABLED=false
# To enable LIVE, notify the user first, set LIVE/true above and supply these via host secrets:
# OPENAI_API_KEY=
# TYPECAST_API_KEY=
# TYPECAST_JUN_VOICE_ID=tc_660645fb8db3e2c06ff7070b
# TYPECAST_NARA_VOICE_ID=tc_65a8c82a7e7bded32947497e
# TYPECAST_MODEL=ssfm-v30
# Verify the actual model prices before enabling LIVE:
# EF_AGENT_INPUT_USD_PER_MILLION=
# EF_AGENT_OUTPUT_USD_PER_MILLION=
EF_AGENT_MAX_CALLS=85
# Match the existing LIVE demo launcher. The USD2 cap below remains unchanged.
EF_AGENT_MAX_INPUT_TOKENS=500000
EF_AGENT_MAX_OUTPUT_TOKENS=32000
EF_AGENT_MAX_COST_MICROUSD=2000000
EF_MAIL_ENABLED=false
EF_BOOTSTRAP_ADMIN_ENABLED=false

# Historical standalone Jev experiments only. P1 learning never calls Jev (GPT selects cues).
EF_JEV_ENABLED=false
# No TypeSafe key/ledger is needed for the deployed learning flow.
# TYPESAFE_API_KEY=
# EF_JEV_MODEL=jev-latest
# EF_JEV_MAX_REQUESTS=3
# EF_JEV_LEDGER_DIRECTORY=/var/lib/emotionfriend/jev-first3
