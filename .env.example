# Copy values into Render > Environment. Spring Boot does not load .env automatically.
SPRING_PROFILE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://<render-internal-host>:5432/<database>
SPRING_DATASOURCE_USERNAME=<database-user>
SPRING_DATASOURCE_PASSWORD=<database-password>
JWT_SECRET=<random-secret-at-least-32-bytes>
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://<frontend-host>
SWAGGER_SERVER_URL=https://<backend-host>

# First empty DB only: temporarily use update, then return to validate.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# OpenAI-compatible text generation. Include /v1 if required by your provider.
LLM_ENABLED=true
LLM_BASE_URL=https://<generation-provider>/v1
LLM_API_KEY=<generation-api-key>
LLM_MODEL_FLASH=<generation-model>
LLM_MODEL_PRO=<generation-model>
# Optional; leave blank unless your provider/model supports reasoning_effort.
LLM_THINK=
LLM_MAX_RETRIES=2
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=120

# Independent embeddings API; never use the generation key as a fallback.
SPRING_AI_EMBEDDING_MODEL=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=<openai-embedding-api-key>
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MAX_ATTEMPTS=3
SPRING_AI_VECTORSTORE_TYPE=pgvector
SPRING_AI_PGVECTOR_INITIALIZE_SCHEMA=true
RAG_VECTOR_TABLE=vector_store_openai_1536

# Private Cloudflare R2 bucket, accessed using its S3-compatible API.
APP_STORAGE_TYPE=s3
S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
S3_SIGNED_URL_DURATION_SECONDS=300

# Optional realtime feature, independent from generation and embeddings.
OPENAI_REALTIME_ENABLED=false
