# Reference only. Spring Boot does not automatically load this file.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/emotion_friend
SPRING_DATASOURCE_USERNAME=emotion_friend
SPRING_DATASOURCE_PASSWORD=
# Generate two DIFFERENT random 32-byte Base64 secrets. No default keys exist.
EF_IDEMPOTENCY_FINGERPRINT_KEY=
EF_IDEMPOTENCY_ENCRYPTION_KEY=
# A THIRD independent random 32-byte Base64 secret; keep stable across restarts.
EF_JWT_SIGNING_KEY=

# Set false to disable Swagger UI and generated OpenAPI endpoints.
EF_API_DOCS_ENABLED=true

# Explicit one-time administrator provisioning. Disable/remove credentials after first startup.
EF_BOOTSTRAP_ADMIN_ENABLED=false
EF_BOOTSTRAP_ADMIN_EMAIL=
EF_BOOTSTRAP_ADMIN_PASSWORD=

# Backend only. Enable after Resend domain verification and sender configuration.
EF_MAIL_ENABLED=false
EF_RESEND_API_KEY=
EF_MAIL_FROM=
# Local browser testing: http://localhost:5173 ; deployment: https://your-web-domain
EF_FRONTEND_BASE_URL=
